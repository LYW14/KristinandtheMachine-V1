    <p>&copy; {year} KristinandtheMachine.</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="mailto:kristinandthemachine@gmail.com" class="text-clay/70 decoration-clay/30 hover:text-oxblood">
        kristinandthemachine@gmail.com
      </a>
      <a
        href="https://www.instagram.com/kristinandthemachine/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-clay/70 decoration-clay/30 hover:text-oxblood"
