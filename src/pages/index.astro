---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
---

<BaseLayout
  title="Home"
  description="Ceramic artist, wheel thrower, and aspiring instructor. Portfolio and teaching philosophy."
  active="home"
>
  <!-- Hero: full-width, replace PlaceholderImage with a real <img> when
       photography is ready. Kept as its own block so the swap is a
       one-line change. -->
  <section class="w-full">
    <PlaceholderImage
      alt="Hero photograph of finished ceramic work, arranged on a studio shelf"
      ratio="aspect-[16/10] sm:aspect-[21/9]"
      class="w-full"
    />
  </section>

  <!-- Name + intro -->
  <section class="mx-auto max-w-6xl px-6 py-14 sm:px-8 sm:py-20">
    <div class="max-w-measure">
      <h1 class="font-display text-4xl text-ink sm:text-5xl">Kristin Wang</h1>
      <p class="mt-3 font-display text-lg italic text-clay/80">
        Ceramic Artist &middot; Wheel Thrower &middot; Aspiring Instructor
      </p>

      <p class="mt-8 text-base leading-relaxed text-clay sm:text-lg">
        Kristin and the Machine is the ceramics practice of Kristin Wang. 
        I started pottery nearly five years ago and have been making ever since, 
        moving between community studios in San Francisco, New York, and Boston along the way. 
        My work is mostly wheel-thrown and functional, pulling ideas from nature, patterns, textures, 
        and everyday things that catch my attention.
      </p>

      <a href="/work" class="btn-primary mt-10">
        View My Work
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
