---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home"
  description="Artist portfolio"
  active="home"
>
  <section class="w-full">
    <img
      src="/images/home-hero.png"
      alt="A row of finished ceramic cups, each with a different hand-painted or glazed pattern, held up one at a time"
      class="w-full object-cover object-center"
    />
  </section>

  <!-- Name + intro -->
  <section class="mx-auto max-w-6xl px-6 py-14 sm:px-8 sm:py-20">
    <div class="max-w-measure">
      <h1 class="font-display text-4xl text-ink sm:text-5xl">KristinandtheMachine</h1>
      <p class="mt-3 font-display text-lg italic text-clay/80">
        Kristin and the Machine is the ceramics practice of Kristin Wang. 
      </p>

      <p class="mt-8 text-base leading-relaxed text-clay sm:text-lg">
        I started pottery nearly five years ago and have been making ever since, 
        moving between community studios in San Francisco, New York, and Boston along the way. My work is mostly wheel-thrown and functional, 
        pulling ideas from nature, patterns, textures, and everyday things that catch my attention.
      </p>

      <a href="/work" class="btn-primary mt-10">
        View My Work
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>
