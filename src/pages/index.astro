---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
---

<BaseLayout
  title="Home"
  description="Ceramic artist, wheel thrower, and aspiring instructor. Portfolio and teaching philosophy."
  active="home"
>
  <!-- Hero: full-width, replace PlaceholderImage with a real <img> when
       photography is ready. Kept as its own block so the swap is a
       one-line change. -->
  <section class="w-full">
    <PlaceholderImage
      alt="Hero photograph of finished ceramic work, arranged on a studio shelf"
      ratio="aspect-[16/10] sm:aspect-[21/9]"
      class="w-full"
    />
  </section>

  <!-- Name + intro -->
  <section class="mx-auto max-w-6xl px-6 py-14 sm:px-8 sm:py-20">
    <div class="max-w-measure">
      <h1 class="font-display text-4xl text-ink sm:text-5xl">Kristin Wang</h1>
      <p class="mt-3 font-display text-lg italic text-clay/80">
        Ceramic Artist &middot; Wheel Thrower &middot; Aspiring Instructor
      </p>

      <p class="mt-8 text-base leading-relaxed text-clay sm:text-lg">
        I discovered ceramics five years ago after college while working in the corporate
        world. What started as a curiosity gradually became the creative practice I return to
        every week. Since then, I've learned in community studios across San Francisco,
        Boston, and New York, where I've been inspired not only by talented instructors but by
        the communities they built around making. I'm excited to begin teaching and help
        others discover the same joy, patience, and confidence that ceramics has given me.
      </p>

      <a href="/work" class="btn-primary mt-10">
        View My Work
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Artist-at-work: deliberately not a generic card. Full-bleed image on
       one side, text set against a soft mist-toned block on the other —
       this is the section doing the most work to show the person behind
       the pieces, which matters for an instructor application. -->
  <section class="bg-mist-50">
    <div class="mx-auto grid max-w-6xl items-stretch gap-0 sm:grid-cols-2">
      <PlaceholderImage
        alt="The artist centering clay at the wheel, mid-throw"
        ratio="aspect-[4/5] sm:aspect-auto"
        class="sm:h-full"
      />
      <div class="flex flex-col justify-center px-6 py-14 sm:px-14 sm:py-0">
        <span class="eyebrow">At the Wheel</span>
        <p class="mt-4 max-w-measure font-display text-2xl leading-snug text-ink sm:text-3xl">
          Every finished piece starts the same way: hands, water, and a few minutes of getting
          the clay to trust you.
        </p>
        <p class="mt-6 max-w-measure text-clay/90">
          Most of what I know about patience, I learned sitting at this wheel — and most of
          what I hope to teach isn't really about ceramics at all.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
