---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { workPieces } from '../data/work';
---

<BaseLayout title="Work" description="A collection of finished ceramic pieces." active="work">
  <section class="mx-auto max-w-6xl px-6 pb-4 pt-14 sm:px-8 sm:pt-20">
    <h1 class="font-display text-4xl text-ink sm:text-5xl">Work</h1>
    <p class="mt-4 max-w-measure text-clay/90">
      A selection of finished pieces &mdash; functional ware, larger forms, and a few
      experiments along the way.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-10 sm:px-8 sm:py-14">
    <GalleryGrid pieces={workPieces} />
  </section>

  <Lightbox />
</BaseLayout>
